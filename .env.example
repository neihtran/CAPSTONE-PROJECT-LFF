# ============================================================
# Cấu hình bắt buộc
# ============================================================

# Clerk — auth provider (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Database — MySQL (PlanetScale, Railway, RDS, ...)
DATABASE_URL="mysql://user:password@localhost:3306/dbname"

# LiveKit — streaming server (https://cloud.livekit.io)
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_WS_URL=

# UploadThing — file upload (https://uploadthing.com)
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=
UPLOADTHING_TOKEN=

# ============================================================
# Tính năng nâng cao — không bắt buộc cho dev local
# (Thiếu thì fail-open, tự động bỏ qua feature đó)
# ============================================================

# Upstash Redis — Rate Limit cho follow/block/ingress.
# Lấy tại: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenAI — AI Chat Moderation cho tính năng chat real-time.
# Lấy tại: https://platform.openai.com/api-keys
# Model: omni-moderation-latest (miễn phí)
OPENAI_API_KEY=
